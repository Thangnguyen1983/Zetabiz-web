{
  "cleanUrls": false,
  "regions": [
    "sin1"
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://zuucoqfylagcfwnhomet.supabase.co wss://zuucoqfylagcfwnhomet.supabase.co; img-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/tai-khoan/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "biztech-web.vercel.app"
        }
      ],
      "destination": "https://mhtbiz.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "biztech-web-mhtbiz.vercel.app"
        }
      ],
      "destination": "https://mhtbiz.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zetabiz.vercel.app"
        }
      ],
      "destination": "https://mhtbiz.com/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/tai-khoan/",
      "permanent": false
    },
    {
      "source": "/portal/:path*",
      "destination": "/tai-khoan/",
      "permanent": false
    },
    {
      "source": "/tai-khoan",
      "destination": "/tai-khoan/",
      "permanent": true
    },
    {
      "source": "/kien-thuc",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/kien-thuc/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/blog?v=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/blog?v=robots"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/blog?v=rss"
    },
    {
      "source": "/blog/chu-de/:slug",
      "destination": "/api/blog?v=cat&slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    }
  ]
}
